{
  "manifest_version": 3,
  "name": "VibePrompt",
  "short_name": "VibePrompt",
  "version": "2.2.0",
  "description": "Minimal, context-aware prompt adaptation for ChatGPT, Claude, Gemini, Grok, DeepSeek, and more.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.x.com/*",
        "https://x.com/i/grok*",
        "https://x.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content/sites.js",
        "content/personalModel.js",
        "content/modal.js",
        "content/content.js"
      ],
      "css": ["content/content.css", "content/modal.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Show VibePrompt",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
